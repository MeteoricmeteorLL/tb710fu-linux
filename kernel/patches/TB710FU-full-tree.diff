+/* TB710FU: the boot ladder is in init/main.c; see tb_mark(). */
+/* TB710FU: read /memory out of the flat tree and put it on the panel. */
+extern void tb_mem_bar(u64 base, u64 bytes, unsigned int banks);
+
+static int __init tb_mem_scan(unsigned long node, const char *uname,
+			      int depth, void *data)
+{
+	static int cells;
+	u64 *acc = data;
+	const __be32 *prop;
+	int len, i, ac, sc;
+
+	if (depth == 0) {
+		prop = of_get_flat_dt_prop(node, "#address-cells", &len);
+		ac = prop ? be32_to_cpup(prop) : 2;
+		prop = of_get_flat_dt_prop(node, "#size-cells", &len);
+		sc = prop ? be32_to_cpup(prop) : 2;
+		cells = (ac << 4) | sc;
+		return 0;
+	}
+
+	prop = of_get_flat_dt_prop(node, "device_type", &len);
+	if (!prop || len < 8 || strncmp((const char *)prop, "memory", 6))
+		return 0;
+
+	prop = of_get_flat_dt_prop(node, "reg", &len);
+	if (!prop || !len)
+		return 0;
+
+	ac = (cells >> 4) & 0xf;
+	sc = cells & 0xf;
+	for (i = 0; i + ac + sc <= len / 4; i += ac + sc) {
+		u64 size = 0;
+		int k;
+
+		for (k = 0; k < sc; k++)
+			size = (size << 32) | be32_to_cpup(prop + i + ac + k);
+		acc[0]++;
+		acc[1] += size;
+	}
+
+	return 0;
+}
+
+static void __init tb_mem_show(void)
+{
+	u64 acc[2] = { 0, 0 };
+
+	of_scan_flat_dt(tb_mem_scan, acc);
+	pr_info("TB MEMORY: %llu banks, %llu MiB total\n", acc[0], acc[1] >> 20);
+	/* identity: this runs before paging_init() builds the linear map */
+	tb_mem_bar(0xd5100000UL, acc[1], (unsigned int)acc[0]);
+}
