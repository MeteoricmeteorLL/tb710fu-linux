+/* ---------------------------------------------------------------------------
+ * TB710FU: an early console on the panel.
+ *
+ * There is no UART on this board, and fbcon cannot take the panel over until a
+ * framebuffer driver registers during do_initcalls(). So this draws the
+ * kernel's messages itself, with the kernel's own font, from the moment the
+ * linear map exists. CON_PRINTBUFFER makes register_console() replay the whole
+ * printk ring into it, so the boot's history appears on the panel at once.
+ *
+ * 8x16 glyphs at scale 4: 100 columns. The panel is split: the top 24 rows are
+ * the live log (and always show its tail), and the bottom 7 rows are a band
+ * holding the last lines of the *previous* boot, recovered from the black box.
+ * The screen can only show one thing, and the line that matters - where a boot
+ * stopped - is otherwise gone the moment the display dies.
+ */
+#define TB_CON_S	4			/* glyph scale: 100 cols x 31 rows, readable in a photo */
+#define TB_CON_W	3200			/* panel stride, pixels */
+#define TB_CON_COLS	(TB_CON_W / (8 * TB_CON_S))
+#define TB_CON_CELLH	(16 * TB_CON_S)
+#define TB_CON_LOG_ROWS	24
+#define TB_CON_BAND_ROWS 6
+#define TB_CON_ROWS	(TB_CON_LOG_ROWS + TB_CON_BAND_ROWS)
+#define TB_CON_RING	(TB_CON_LOG_ROWS * TB_CON_COLS)
+
+#include <linux/font.h>
+#include <asm/irq_regs.h>
+#include <asm/ptrace.h>
+#include <linux/platform_device.h>
+#include <linux/interconnect.h>
+#include <linux/workqueue.h>
+#include <linux/of.h>
+#include <linux/reboot.h>
+#include <linux/jiffies.h>
+extern void dcache_clean_poc(unsigned long start, unsigned long end);
+
+static char tb_con_ring[TB_CON_RING];
+static unsigned int tb_con_head;
+static unsigned int tb_hb_count;	/* heartbeats so far, shown by the band gauge */
+static const struct font_desc *tb_con_font;
+static char tb_bb_band[TB_CON_BAND_ROWS * TB_CON_COLS];
+
+/* ---------------------------------------------------------------------------
+ * TB710FU: the black box.
+ *
+ * Every console character is also appended here, to rings in plain RAM that are
+ * meant to survive the reset, and the next boot shows the tail of the previous
+ * one in the band along the bottom of the panel.  The screen is the only output
+ * this board has and it dies part-way into boot, so the tail - the part that
+ * says where a boot stopped - is otherwise unreadable and unphotographable.
+ *
+ * Two slots, because whether it survived must not be a guess: slot A sits above
+ * every buffer U-Boot fills (it reads a kernel, a 16 MiB device tree and an
+ * initrd into 0xA8000000..0xAD200000) but could be inside U-Boot's own heap;
+ * slot B sits inside the display reservation the bootloader keeps its splash in,
+ * past the 3200x2000x4 visible frame, and so out of U-Boot's way entirely.  Both
+ * are mirrored on every write and the band's first line reports each, so a
+ * single boot says which address is really left alone.  Slots must be reserved
+ * in the DTS without no-map: reserved, so the page allocator keeps off them,
+ * still mapped, so __va() reaches them.
+ */
+#define TB_BB_SLOTS	2
+#define TB_BB_SIZE	0x100000UL
+#define TB_BB_MAGIC	0x4c424254	/* "TBBL" */
+#define TB_BB_SHOW	4000		/* how far back to look for the band */
+
+static const u64 tb_bb_pa[TB_BB_SLOTS] = {
+	0xB0000000UL,
+	0xD6A00000UL,
+};
+
+struct tb_bb {
+	u32 magic;
+	u32 head;		/* bytes ever appended */
+	u32 boots;
+	u32 size;		/* capacity of data[] */
+	char data[];
+};
+
+static u32 tb_bb_seam[TB_BB_SLOTS];	/* where this boot's log starts in each */
+static u32 tb_bb_was_head[TB_BB_SLOTS];
+static u32 tb_bb_was_boots[TB_BB_SLOTS];
+static bool tb_bb_ok[TB_BB_SLOTS];	/* the previous boot's text was still there */
+
+static bool tb_bb_mute;		/* set while replaying the previous boot */
+
+static void tb_bb_put(const char *s, unsigned int n)
+{
+	int k;
+
+	if (tb_bb_mute)
+		return;
+
+	for (k = 0; k < TB_BB_SLOTS; k++) {
+		struct tb_bb *bb = (struct tb_bb *)__va(tb_bb_pa[k]);
+		u32 cap = TB_BB_SIZE - sizeof(*bb);
+		u32 before, written, off, first;
+		unsigned int i;
+
+		if (!bb->size)		/* never marked: leave it alone */
+			continue;
+
+		before = bb->head;
+		for (i = 0; i < n; i++) {
+			char c = s[i];
+
+			if (c == '\r' || !c)
+				continue;
+			bb->data[bb->head % cap] = c;
+			bb->head++;
+		}
+		written = bb->head - before;
+
+		/* Push it out as we go: the display reads this with the caches off, and
+		 * the next boot may not get a cache flush on the way down.  Only the
+		 * spans this call touched - the whole ring would make every printk pay
+		 * for a megabyte. */
+		dcache_clean_poc((unsigned long)bb, (unsigned long)(bb + 1));
+		off = before % cap;
+		if (written) {
+			first = written < cap - off ? written : cap - off;
+			dcache_clean_poc((unsigned long)(bb->data + off),
+					 (unsigned long)(bb->data + off + first));
+			if (written > first)
+				dcache_clean_poc((unsigned long)bb->data,
+						 (unsigned long)(bb->data + written - first));
+		}
+	}
+}
