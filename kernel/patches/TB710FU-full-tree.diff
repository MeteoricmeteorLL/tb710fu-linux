+{
+	pr_info("TB ICC keepalive: %s (%d path(s) held)\n",
+		tb_icc_keepalive_held ? "vote is HELD" : "NO VOTE - the driver never probed",
+		tb_icc_keepalive_held);
+
+	return 0;
+}
+/* DISABLED-BISECT: late_initcall_sync(tb_icc_keepalive_report); */
+
+
+/* ---------------------------------------------------------------------------
+ * TB710FU: a heartbeat.
+ *
+ * The panel can die the moment the kernel takes over, which leaves "the screen
+ * is black" saying nothing about whether the kernel died or is running with a
+ * dead display.  A line every two seconds fixes that: the tail of the log - and
+ * therefore the band on the next boot, and the black box - always says the
+ * second the kernel was last alive.  The initramfs adds its own lines
+ * ("TBINIT:", "alive t=Ns udc=[...]") once user space is reached.
+ */
+static void tb_gauge_draw(void);	/* defined below */
+#define TB_BB_DUMP_LINES	24
+static void tb_bb_dump_prev(int want);	/* defined below */
+static void tb_bb_dump_head(int want);
+static void tb_bb_dump_keys(int want);
+static void tb_initcall_bar(unsigned long fn);	/* defined below */
+#define TB_HEARTBEAT_SECS	10
+
+static void tb_heartbeat_fn(struct timer_list *t)
+{
+	struct pt_regs *regs = get_irq_regs();
+	unsigned long pc = regs ? instruction_pointer(regs) : 0;
+
+	tb_hb_count++;
+	/* throttled: the old 5s/28-line key dumps filled the ring buffer in
+	 * under a minute and rolled the TBDUMP snapshots before the console
+	 * could pull them */
+	if (tb_hb_count % 6 == 0)
+		tb_bb_dump_keys(28);
+	else if (tb_hb_count % 12 == 7)
+		tb_bb_dump_prev(10);
+	pr_info("TB ALIVE t=%us hb=%u pc=%px\n",
+		(unsigned int)((jiffies - INITIAL_JIFFIES) / HZ), tb_hb_count,
+		(void *)pc);
+	tb_gauge_draw();
+	tb_initcall_bar(pc);
+	mod_timer(t, jiffies + TB_HEARTBEAT_SECS * HZ);
+}
+
+static struct timer_list tb_heartbeat_timer;
+
+static int __init tb_heartbeat_init(void)
+{
+	timer_setup(&tb_heartbeat_timer, tb_heartbeat_fn, 0);
+	mod_timer(&tb_heartbeat_timer, jiffies + TB_HEARTBEAT_SECS * HZ);
+
+	return 0;
+}
+early_initcall(tb_heartbeat_init);
+
+/* ---------------------------------------------------------------------------
+ * TB710FU: a liveness meter that does not depend on the console.
+ *
+ * When the panel is black there is no way to tell "the kernel died" from "the
+ * kernel is running and the display is gone", and the black box needs a warm
+ * reset to survive.  So the heartbeat draws one green square per tick directly
+ * into a fixed row of the framebuffer: no printk, no font, no ring state, so
+ * nothing the console does can break it.  A photo of that row gives the number
+ * of 2-second ticks the kernel lived, with a red square marking the count.
+ */
+#define TB_GAUGE_Y	(TB_CON_LOG_ROWS * TB_CON_CELLH)	/* first band row */
+#define TB_GAUGE_BOX	28
+#define TB_GAUGE_STEP	34
+
+static void tb_gauge_draw(void)
+{
+	volatile u32 *fb = (volatile u32 *)__va(TB_FB_PHYS);
+	unsigned int i, n = tb_hb_count;
+	unsigned long start, end;
+
+	if (n > 90)
+		n = 90;
+
+	for (i = 0; i <= n; i++) {
+		volatile u32 *p = fb + (unsigned long)(TB_GAUGE_Y + 18) * TB_CON_W +
+				  120 + i * TB_GAUGE_STEP;
+		int r, c;
+
+		for (r = 0; r < TB_GAUGE_BOX; r++)
+			for (c = 0; c < TB_GAUGE_BOX; c++)
+				p[(unsigned long)r * TB_CON_W + c] =
+					(i < n) ? 0xff00ff00 : 0xffff0000;
+	}
+
+	start = (unsigned long)(fb + (unsigned long)(TB_GAUGE_Y + 18) * TB_CON_W + 120);
+	end = start + (unsigned long)(TB_GAUGE_BOX + 2) * TB_CON_W * 4;
+	dcache_clean_poc(start, end);
+}
+
+/* ---------------------------------------------------------------------------
+ * TB710FU: instruments that survive a broken console.
+ *
+ * do not survive a panel console that repaints the same rows, and a stale screen
+ * looks exactly like a fresh one.  Two additions:
+ *
+ *  - the bottom 16-pixel strip of the panel (which the console never paints - it
+ *    stops at row 30) carries one square per tb_mark() call, newest in red, so a
+ *    photo of the bottom edge says how many ladder rungs the kernel reached;
+ *  - the band gauge carries a number derived from CNTPCT, the arch timer's
+ *    free-running counter, which keeps counting across resets: identical numbers
+ *    in two photos mean the screen is stale, different numbers mean it is live.
+ */
+#define TB_STRIP_Y	1952			/* below the console's 30 rows */
+#define TB_STRIP_BOX	32
+#define TB_STRIP_STEP	36
+
+static void tb_strip_draw(u64 base, unsigned int n)
+{
+	/* Same base as the rung that triggered this call: the early rungs run
+	 * before paging_init() exists and must go through the identity mapping. */
+	volatile u32 *fb = (volatile u32 *)base;
+	unsigned int i;
+	unsigned long start, end;
+
+	if (n > 99)
+		n = 99;
+
+	/* Clear our own row first: an earlier boot that got further would otherwise
+	 * leave extra squares behind and inflate the count a photo shows. */
+	for (i = 0; i < TB_STRIP_BOX; i++) {
+		volatile u32 *row = fb + (unsigned long)(TB_STRIP_Y + i) * TB_CON_W;
+		int c;
+
+		for (c = 0; c < TB_CON_W; c++)
+			row[c] = 0xff000000;
+	}
+
+	for (i = 0; i <= n; i++) {
+		volatile u32 *p = fb + (unsigned long)TB_STRIP_Y * TB_CON_W + 2 + i * TB_STRIP_STEP;
+		int r, c;
+
+		for (r = 0; r < TB_STRIP_BOX; r++)
+			for (c = 0; c < TB_STRIP_BOX; c++)
+				p[(unsigned long)r * TB_CON_W + c] = (i < n) ? 0xff00ff00 : 0xffff0000;
+	}
+
+	start = (unsigned long)(fb + (unsigned long)TB_STRIP_Y * TB_CON_W);
+	end = start + (unsigned long)TB_STRIP_BOX * TB_CON_W * 4;
+	dcache_clean_poc(start, end);
+}
+
+static unsigned int tb_boot_stamp(void)
+{
+	u64 cnt;
+
+	asm volatile("mrs %0, cntpct_el0" : "=r"(cnt));
+	if (!cnt)				/* no arch timer yet: fall back */
+		cnt = jiffies;
+
+	return (unsigned int)((cnt / 1000) % 1000000);
+}
+
+
+/* ---------------------------------------------------------------------------
+ * TB710FU: show the /memory the kernel was actually handed.
+ *
+ * The kernel stops inside paging_init(), which builds the linear map from the
+ * device tree's /memory.  U-Boot's log says RAM TOT e649c000 (~3.86 GB) while the
+ * board dts declares 0x80000000 + 8 GiB; memory that large reaches past the real
+ * RAM, and memblock handing out page tables from the hole would be a synchronous
+ * external abort exactly there.  This draws the tree's answer, so a photo settles
+ * it: green squares = 256 MB each of total RAM, red squares to the right = one
+ * per /memory bank.
+ */
+#define TB_MEMBAR_Y	(uint)(TB_CON_ROWS * TB_CON_CELLH + 32)
+
+void tb_mem_bar(u64 base, u64 bytes, unsigned int banks)
+{
+	/* Same base as the rung this is called from: it runs before
+	 * paging_init() exists and must go through the identity map. */
+	volatile u32 *fb = (volatile u32 *)base;
+	unsigned long n = (unsigned long)(bytes >> 28);	/* 256 MB units */
+	unsigned int i;
+	unsigned long start, end;
+
+	if (n > 40)
+		n = 40;
+	if (banks > 8)
+		banks = 8;
+
+	/* Same reasoning as the strip: clear our own row so the count is this boot's. */
+	for (i = 0; i < TB_STRIP_BOX; i++) {
+		volatile u32 *row = fb + (unsigned long)(TB_MEMBAR_Y + i) * TB_CON_W;
+		int c;
+
+		for (c = 0; c < TB_CON_W; c++)
+			row[c] = 0xff000000;
+	}
+
+	for (i = 0; i < n; i++) {
+		volatile u32 *p = fb + (unsigned long)TB_MEMBAR_Y * TB_CON_W + 2 + i * TB_STRIP_STEP;
+		int r, c;
+
+		for (r = 0; r < TB_STRIP_BOX; r++)
+			for (c = 0; c < TB_STRIP_BOX; c++)
+				p[(unsigned long)r * TB_CON_W + c] = 0xff00ff00;
+	}
+
+	for (i = 0; i < banks; i++) {
+		volatile u32 *p = fb + (unsigned long)TB_MEMBAR_Y * TB_CON_W + 1600 + i * TB_STRIP_STEP;
+		int r, c;
+
+		for (r = 0; r < TB_STRIP_BOX; r++)
+			for (c = 0; c < TB_STRIP_BOX; c++)
+				p[(unsigned long)r * TB_CON_W + c] = 0xffff0000;
+	}
+
+	start = (unsigned long)(fb + (unsigned long)TB_MEMBAR_Y * TB_CON_W);
+	end = start + (unsigned long)TB_STRIP_BOX * TB_CON_W * 4;
+	dcache_clean_poc(start, end);
+}
+
+
+/* ---------------------------------------------------------------------------
+ * TB710FU: name the initcall that never returns.
+ *
+ * The rung counter says the kernel reaches the end of the initcall sequence -
+ * where the old logs stopped too (the deferred probe report).  The console's
+ * character count cannot refine that, because this kernel's printk delivers
+ * console output from a kthread: a kernel that never goes idle leaves the console
+ * showing only the banner.
+ *
+ * So write the address of the last do_one_initcall() target into the panel as 32
+ * bit-squares (bit 0 leftmost, green = 1, black = 0).  Read it off a photo, look
+ * it up in System.map, and the function is named.
+ */
+#define TB_BITS_Y	1920
+#define TB_BITS_BOX	32
+#define TB_BITS_GROUP	6
+#define TB_BITS_CELL	520
+#define TB_BITS_UNIT	32
+
+/* Six bars, one per hex digit of the address's low 24 bits: each starts at a fixed
+ * cell and its length is (digit + 1) * 32 px (32..512), so reading six lengths gives six hex
+ * digits.  Counting bit-squares off a phone photo does not work; comparing bar
+ * lengths does.  Look the value up in System.map. */
+static void tb_initcall_bar(unsigned long fn)
+{
+	volatile u32 *fb = (volatile u32 *)__va(TB_FB_PHYS);
+	unsigned long start, end;
+	int g, i, r, c;
+
+	for (i = 0; i < TB_BITS_BOX; i++) {
+		volatile u32 *row = fb + (unsigned long)(TB_BITS_Y + i) * TB_CON_W;
+		int k;
+
+		for (k = 0; k < TB_CON_W; k++)
+			row[k] = 0xff000000;
+	}
+
+	for (g = 0; g < TB_BITS_GROUP; g++) {
+		unsigned long digit = (fn >> (g * 4)) & 0xf;
+		unsigned long len = (digit + 1) * TB_BITS_UNIT;
+		volatile u32 *p = fb + (unsigned long)TB_BITS_Y * TB_CON_W +
+				  20 + g * TB_BITS_CELL;
+
+		for (r = 0; r < TB_BITS_BOX; r++)
+			for (c = 0; c < (int)len; c++)
+				p[(unsigned long)r * TB_CON_W + c] = 0xff00ff00;
+	}
+
+	start = (unsigned long)(fb + (unsigned long)TB_BITS_Y * TB_CON_W);
+	end = start + (unsigned long)TB_BITS_BOX * TB_CON_W * 4;
+	dcache_clean_poc(start, end);
+}
+
+
+/* Print the previous boot's tail as ordinary log lines: slot A survives this
+ * device's own resets, and five band rows are nowhere near enough to see why a
+ * boot ended.  Muted from the box so the dump cannot overwrite what it reads. */
+
+static void tb_bb_dump_prev(int want)
+{
+	/* Slot 0, unconditionally: this reads *this* boot's own opening lines, which
+	 * the mirror has been writing since the first console write - no need for any
+	 * of it to have survived a reset (tb_bb_ok is about the previous boot). */
+	int pick = 0;
+	struct tb_bb *bb;
+	u32 cap = TB_BB_SIZE - sizeof(struct tb_bb);
+	u32 start;
+	char line[TB_CON_COLS + 1];
+	unsigned int col = 0, i;
+	int shown = 0, lines = 0;
+
+	if (pick < 0 || !tb_bb_seam[pick]) {
+		pr_info("TB PREV: no black box content\n");
+		return;
+	}
+
+	bb = (struct tb_bb *)__va(tb_bb_pa[pick]);
+	start = tb_bb_seam[pick] > 8000 ? tb_bb_seam[pick] - 8000 : 0;
+
+	/* count the lines in the window first, so we can print only the last ones */
+	for (i = start; i < tb_bb_seam[pick]; i++)
+		if (bb->data[i % cap] == '\n')
+			lines++;
+
+	tb_bb_mute = true;
+	pr_info("=== PREVIOUS BOOT (black box, %d lines, showing last %d) ===\n",
+		lines, want);
+	for (i = start; i <= tb_bb_seam[pick]; i++) {
+		char ch = i < tb_bb_seam[pick] ? bb->data[i % cap] : '\n';
+
+		if (ch != '\n') {
+			if (col < TB_CON_COLS)
+				line[col] = (ch >= 32 && ch < 127) ? ch : ' ';
+			col++;
+			continue;
+		}
+		if (col) {
+			line[col < TB_CON_COLS ? col : TB_CON_COLS] = 0;
+			if (lines - shown <= want) {
+				pr_info("PREV| %s\n", line);
+				shown++;
+			}
+		}
+		col = 0;
+	}
+	pr_info("=== END PREVIOUS BOOT ===\n");
+	tb_bb_mute = false;
+}
+
+
+/* Print this boot's own opening lines from the black box, which has been
+ * recording since the first console write.  The early boot messages are what
+ * scrolls away first and they are the ones usually wanted (driver probe results,
+ * for instance the DWC3/USB outcome) - re-print them so a photo taken at any time
+ * still shows them. */
+static void tb_bb_dump_head(int want)
+{
+	/* This boot's own mirror: no cross-reset condition applies here. */
+	int pick = 0;
+	struct tb_bb *bb;
+	u32 cap = TB_BB_SIZE - sizeof(struct tb_bb);
+	u32 end;
+	char line[TB_CON_COLS + 1];
+	unsigned int col = 0, i;
+	int shown = 0;
+
+	bb = (struct tb_bb *)__va(tb_bb_pa[pick]);
+	if (!bb->head)			/* nothing mirrored yet */
+		return;
+
+	end = tb_bb_seam[pick] + 6000;
+	if (end > bb->head)
+		end = bb->head;
+
+	tb_bb_mute = true;
+	pr_info("=== THIS BOOT, FIRST %d LINES ===\n", want);
+	for (i = tb_bb_seam[pick]; i <= end && shown < want; i++) {
+		char ch = i < end ? bb->data[i % cap] : '\n';
+
+		if (ch != '\n') {
+			if (col < TB_CON_COLS)
+				line[col] = (ch >= 32 && ch < 127) ? ch : ' ';
+			col++;
+			continue;
+		}
+		if (col) {
+			line[col < TB_CON_COLS ? col : TB_CON_COLS] = 0;
+			pr_info("HEAD| %s\n", line);
+			shown++;
+		}
+		col = 0;
+	}
+	pr_info("=== END ===\n");
+	tb_bb_mute = false;
+}
+
+
+/* Re-print only the interesting lines from this boot's mirror: the machine model
+ * (which device tree did the kernel actually receive?) and the USB chain.  Muted
+ * from the box. */
+static const char *const tb_key_words[] = {
+	"Machine model", "USB", "usb", "dwc3", "udc", "phy", "PHY",
+	"Unable", "panic", "Call trace", "cdev", "gadget",
+};
+
+static bool tb_bb_line_matches(const char *line)
+{
+	int i;
+
+	/* fw_devlink's cycle reports match "phy"/"usb" but say nothing about the
+	 * probe results we are after. */
+	if (strstr(line, "Fixed dependency cycle"))
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(tb_key_words); i++)
+		if (strstr(line, tb_key_words[i]))
+			return true;
+
+	return false;
+}
+
+static void tb_bb_dump_keys(int want)
+{
+	struct tb_bb *bb = (struct tb_bb *)__va(tb_bb_pa[0]);
+	u32 cap = TB_BB_SIZE - sizeof(struct tb_bb);
+	u32 end;
+	char line[TB_CON_COLS + 1];
+	unsigned int col = 0, i;
+	int shown = 0, seen = 0;
+
+	end = bb->head;
+	if (!end)
+		return;
+
+	/* pass 1: how many lines match, so we can print only the last `want` */
+	{
+		int total = 0;
+
+		col = 0;
+		for (i = tb_bb_seam[0]; i <= end; i++) {
+			char ch = i < end ? bb->data[i % cap] : '\n';
+
+			if (ch != '\n') {
+				if (col < TB_CON_COLS)
+					line[col] = (ch >= 32 && ch < 127) ? ch : ' ';
+				col++;
+				continue;
+			}
+			if (col) {
+				line[col < TB_CON_COLS ? col : TB_CON_COLS] = 0;
+				if (tb_bb_line_matches(line))
+					total++;
+			}
+			col = 0;
+		}
+
+		tb_bb_mute = true;
+		pr_info("=== KEY LINES (last %d of %d) ===\n", want, total);
+		col = 0;
+		for (i = tb_bb_seam[0]; i <= end; i++) {
+			char ch = i < end ? bb->data[i % cap] : '\n';
+
+			if (ch != '\n') {
+				if (col < TB_CON_COLS)
+					line[col] = (ch >= 32 && ch < 127) ? ch : ' ';
+				col++;
+				continue;
+			}
+			if (col) {
+				line[col < TB_CON_COLS ? col : TB_CON_COLS] = 0;
+				if (tb_bb_line_matches(line)) {
+					/* `seen` counts matches encountered, not ones printed:
+					 * with total-shown the first match would be skipped while
+					 * shown stayed 0, so nothing was ever printed. */
+					if (total - seen <= want) {
+						pr_info("KEY| %s\n", line);
+						shown++;
+					}
+					seen++;
+				}
+			}
+			col = 0;
+		}
+		pr_info("=== END KEY ===\n");
+		tb_bb_mute = false;
+	}
+}
+
+static void tb_con_cell(volatile u32 *fb, int row, int col, unsigned char ch, u32 fg)
+{
+	const unsigned char *g;
+	volatile u32 *base;
+	int r, c, dy, dx;
+
+	if (!tb_con_font)
+		return;
+	g = font_data_glyph_buf(tb_con_font->data, tb_con_font->width,
+				tb_con_font->height, ch);
+	if (!g)
+		return;
+
+	base = fb + (unsigned long)(row * TB_CON_CELLH) * TB_CON_W + col * 8 * TB_CON_S;
+	for (r = 0; r < 16; r++) {
+		unsigned char bits = g[r];
+
+		for (c = 0; c < 8; c++) {
+			u32 v = (bits & (0x80 >> c)) ? fg : 0xff000000;
+			volatile u32 *p = base + (unsigned long)(r * TB_CON_S) * TB_CON_W + c * TB_CON_S;
+
+			for (dy = 0; dy < TB_CON_S; dy++)
+				for (dx = 0; dx < TB_CON_S; dx++)
+					p[(unsigned long)dy * TB_CON_W + dx] = v;
+		}
+	}
+}
+
+static void tb_con_draw(void)
+{
+	volatile u32 *fb = (volatile u32 *)__va(TB_FB_PHYS);
+	unsigned int n = tb_con_head < TB_CON_RING ? tb_con_head : TB_CON_RING;
+	unsigned int first = tb_con_head - n;
+	int r, c;
+
+	if (!tb_con_font)
+		tb_con_font = find_font("VGA8x16");
+
+	for (r = 0; r < TB_CON_LOG_ROWS; r++)
+		for (c = 0; c < TB_CON_COLS; c++)
+			tb_con_cell(fb, r, c,
+				    tb_con_ring[(first + r * TB_CON_COLS + c) % TB_CON_RING],
+				    0xffe0e0e0);
+
+	/* First band row is a live gauge: a photo of the panel then says how long the
+	 * kernel has been alive, how much it has logged, whether the heartbeat is
+	 * ticking, and whether the black box survived the last reset - which is what
+	 * separates "the kernel died" from "the display died". */
+	{
+		char gauge[TB_CON_COLS + 1];
+		int n = snprintf(gauge, sizeof(gauge),
+				 "BB b=%u ch=%u t=%us hb=%u u=%u %s %s",
+				 tb_bb_was_boots[0], tb_con_head,
+				 (unsigned int)((jiffies - INITIAL_JIFFIES) / HZ), tb_hb_count,
+				 tb_boot_stamp(),
+				 tb_bb_ok[0] ? "A:PREV" : "A:fresh",
+				 tb_bb_ok[1] ? "B:PREV" : "B:fresh");
+		int i;
+
+		for (i = 0; i < TB_CON_COLS; i++)
+			tb_bb_band[i] = (n > 0 && i < n) ? gauge[i] : ' ';
+	}
+
+	/* The rest of the band is redrawn with every refresh so the previous boot's
+	 * last lines cannot be scrolled away - they are the whole point of this
+	 * console. */
+	for (r = 0; r < TB_CON_BAND_ROWS; r++)
+		for (c = 0; c < TB_CON_COLS; c++)
+			tb_con_cell(fb, TB_CON_LOG_ROWS + r, c,
+				    tb_bb_band[r * TB_CON_COLS + c], 0xffffc000);
+
+	dcache_clean_poc((unsigned long)fb,
+			 (unsigned long)(fb + (unsigned long)TB_CON_ROWS * TB_CON_CELLH * TB_CON_W));
+}
+
+/* Repainting the panel costs 25 MB of writes plus a cache clean, and with
+ * ignore_loglevel in the cmdline the deferred-probe retry storm sends thousands
+ * of KERN_DEBUG lines through here - hundreds of gigabytes of framebuffer
+ * traffic, which is both why a boot that should take seconds takes ~29 and a
+ * credible way to starve the display's scanout of the same memory.  The panel
+ * shows the tail, so 2 Hz is plenty; the ring and the black box keep every byte. */
+#define TB_CON_REDRAW_JIFFIES	(HZ / 2)
+
+static unsigned long tb_con_next_draw;
+
+static void tb_con_write(struct console *co, const char *s, unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		if (s[i] == '\r')
+			continue;
+		tb_con_ring[tb_con_head % TB_CON_RING] = s[i];
+		tb_con_head++;
+	}
+	tb_bb_put(s, n);
+
+	if (time_after(jiffies, tb_con_next_draw)) {
+		tb_con_draw();
+		tb_con_next_draw = jiffies + TB_CON_REDRAW_JIFFIES;
+	}
+}
+
+static struct console tb_con = {
+	.name	= "tbfb",
+	.write	= tb_con_write,
+	.flags	= CON_PRINTBUFFER,
+	.index	= -1,
+};
+
+/* ---------------------------------------------------------------------------
+ * TB710FU: the previous boot's crash, read back out of ramoops.
+ *
+ * Nothing in this boot has touched 0xAC300000 by the time this runs, and the
