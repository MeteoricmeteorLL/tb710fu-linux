+		param_data->module_instance_id = module->instance_id;
+		param_data->error_code = 0;
+		param_data->param_id = PARAM_ID_HW_EP_MF_CFG;
+		param_data->param_size = size - APM_MODULE_PARAM_DATA_SIZE;
+		hw_cfg->mf.sample_rate = cfg->sample_rate;
+		hw_cfg->mf.bit_width = cfg->bit_width;
+		hw_cfg->mf.num_channels = cfg->num_channels;
+		hw_cfg->mf.data_format = module->data_format;
+		break;
+	case 4:
+		fs_cfg = p;
+		param_data = &fs_cfg->param_data;
+		param_data->module_instance_id = module->instance_id;
+		param_data->error_code = 0;
+		param_data->param_id = PARAM_ID_HW_EP_FRAME_SIZE_FACTOR;
+		param_data->param_size = size - APM_MODULE_PARAM_DATA_SIZE;
+		fs_cfg->frame_size_factor = 1;
+		break;
+	case 8:
+		fd_cfg = p;
+		param_data = &fd_cfg->param_data;
+		param_data->module_instance_id = module->instance_id;
+		param_data->error_code = 0;
+		param_data->param_id = PARAM_ID_HW_EP_FRAME_DURATION;
+		param_data->param_size = size - APM_MODULE_PARAM_DATA_SIZE;
+		fd_cfg->frame_duration.frame_duration_in_us = AUDIO_IF_FRAME_DURATION_US;
+		fd_cfg->frame_duration.allow_frame_duration_normalization =
+			AUDIO_IF_FRAME_DURATION_NORMALIZATION_ENABLE;
+		fd_cfg->frame_duration.min_normalized_frame_dur_us = AUDIO_IF_FRAME_DURATION_MIN_US;
+		fd_cfg->frame_duration.max_normalized_frame_dur_us = AUDIO_IF_FRAME_DURATION_MAX_US;
+		break;
+	case 16:
+		i2s_cfg = p;
+		param_data = &i2s_cfg->param_data;
+		param_data->module_instance_id = module->instance_id;
+		param_data->error_code = 0;
+		param_data->param_id = PARAM_ID_I2S_INTF_CFG;
+		param_data->param_size = size - APM_MODULE_PARAM_DATA_SIZE;
+		i2s_cfg->cfg.lpaif_type = module->hw_interface_type;
+		i2s_cfg->cfg.intf_idx = module->hw_interface_idx;
+		i2s_cfg->cfg.sd_line_idx = module->sd_line_idx ? module->sd_line_idx : 2;
+		i2s_cfg->cfg.ws_src = CONFIG_I2S_WS_SRC_INTERNAL;
+		break;
+	}
+
+	rc = q6apm_send_cmd_sync(graph->apm, pkt, 0);
+	dev_info(graph->dev, "TB TDM param bit=%d rc=%d\n", bit, rc);
+	return rc;
+}
