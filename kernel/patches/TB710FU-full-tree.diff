+	 * acm35/37: 主机侧全程用轮询代替设备中断。
+	 * 先轮询设备侧 BHI_EXECENV 等 mission mode(acm35), 进 AMSS 后补排队
+	 * DEV_ST_TRANSITION_MISSION_MODE, 再起 acm37 的 event-ring 轮询线程
+	 * (代替 MSI, 让 MHI 能收到设备的 M0 state-change 事件与之后所有 QMI 完成)。
+	 * 用 msleep 轮询, 不用长的 wait_event_timeout, 以免触发 hung_task_panic。
+	 */
+	{
+		int i;
+
+		for (i = 0; i < 1200; i++) {
+			enum mhi_ee_type hw_ee;
+
+			if (MHI_IN_MISSION_MODE(mhi_cntrl->ee))
+				break;
+
+			write_lock_irq(&mhi_cntrl->pm_lock);
+			hw_ee = MHI_REG_ACCESS_VALID(mhi_cntrl->pm_state) ?
+				mhi_get_exec_env(mhi_cntrl) : mhi_cntrl->ee;
+			write_unlock_irq(&mhi_cntrl->pm_lock);
+
+			if (hw_ee != mhi_cntrl->ee) {
+				dev_info(&mhi_cntrl->mhi_dev->dev,
+					 "acm35: hw EE %s -> %s\n",
+					 TO_MHI_EXEC_STR(mhi_cntrl->ee),
+					 TO_MHI_EXEC_STR(hw_ee));
+				mhi_cntrl->ee = hw_ee;
+			}
+
+			if (MHI_IN_MISSION_MODE(mhi_cntrl->ee)) {
