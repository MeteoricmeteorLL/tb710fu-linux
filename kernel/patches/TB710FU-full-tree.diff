+/*
+ * Lenovo Xiaoxin Pad Pro GT (TB710FU): Novatek NT36532, 1600x2000 per DSI link
+ * (3200x2000 combined), video mode, 30 bpp, dual DSI.  The init sequence below is
+ * the vendor's own, decoded from its qcom,mdss-dsi-on-command byte stream (the
+ * upstream DSI packet header is dtype, last, vc, ack, wait, then a big-endian u16
+ * length) with the millisecond waits kept.
+ */
+/*
+ * TB710FU bring-up: the vendor tree wires the panel's TE output to TLMM
+ * GPIO 86 (qcom,platform-te-gpio) and runs its ESD check on it, so a live,
+ * display-on panel toggles TE at the frame rate.  Count edges over 100 ms -
+ * this probes panel aliveness without touching the DSI read path, which is
+ * useless to us if the board's data lanes are unidirectional.
+ */
+#define TB710FU_TE_GPIO 86
+
+static void tb710fu_te_check(struct work_struct *work)
+{
+	void __iomem *tlmm;
+	int prev, cur, edges = 0, i;
+
+	/*
+	 * Read the gpio86 pad straight out of the TLMM: gpio_request() on this
+	 * pin fails for reasons unclear, and the pin's mux/enable state is
+	 * whatever ABL left behind - which is exactly what we want, since ABL
+	 * had the panel driving TE into it.
+	 */
+	tlmm = ioremap(0xf100000, 0x60000);
+	if (!tlmm) {
+		pr_err("TBPANEL te: tlmm ioremap failed\n");
+		return;
+	}
+
+	prev = readl_relaxed(tlmm + 86 * 0x1000 + 4) & 1;
+	for (i = 0; i < 2000; i++) {
+		udelay(50);
+		cur = readl_relaxed(tlmm + 86 * 0x1000 + 4) & 1;
+		if (cur != prev) {
+			edges++;
+			prev = cur;
+		}
+	}
+	iounmap(tlmm);
+
+	pr_err("TBPANEL te edges=%d over 100ms (0 = panel silent, ~24 = alive at 120Hz)\n",
+	       edges);
+}
