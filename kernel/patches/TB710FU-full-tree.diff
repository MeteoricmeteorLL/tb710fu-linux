+static void tb_autoreboot_fn(struct timer_list *t)
+{
+	pr_emerg("TB AUTO-REBOOT: %u s without reaching a usable console, booting again\n",
+		 tb_autoreboot_secs);
+	kernel_restart(NULL);
+}
