+static struct platform_driver tb_icc_keepalive_driver = {
+	.probe = tb_icc_keepalive_probe,
+	.driver = {
+		.name = "tb-icc-keepalive",
+		.of_match_table = tb_icc_keepalive_of_match,
+	},
+};
