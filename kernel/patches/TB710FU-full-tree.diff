+/*
+ * TB710FU bring-up: heartbeat so the DSI state is visible even when nothing
+ * errors out.  dsi_error() only prints on a reported fault, which says nothing
+ * when the link is silent but "clean".  frames counts DSI_IRQ_VIDEO_DONE, i.e.
+ * how many frames the video engine actually pushed in the last interval.
+ */
+#define TBDSI_DIAG_MS	10000
+
+/*
+ * TB710FU: the ABL register snapshot showed the vendor leaves these controller
+ * registers in a state our driver never produces - most notably CMD_MODE_EN
+ * set alongside VIDEO_MODE_EN, HS_TIMER_CTRL programmed with a 60000-cycle
+ * timeout, and CLKOUT_TIMING_CTRL left at zero.  The vendor splash streams
+ * perfectly in that state; with mainline's values nothing reaches the panel.
+ * Applied at host enable and re-applied from the heartbeat: the command
+ * transfer path saves/restores CTRL around every DCS write, which silently
+ * reverts anything we only set once.
+ */
+/*
+ * TB710FU: the periodic heartbeat below is bring-up instrumentation and prints
+ * at KERN_ERR, so it lands on the console and in the ring buffer every 10s per
+ * link.  It is off now that the panel streams reliably; turn it back on with
+ *   echo 1 > /sys/module/msm/parameters/tb_dsi_diag
+ * The register writes in tb710fu_ctrl_fixup() still run every round either way.
+ */
+static bool tb_dsi_diag;
+module_param(tb_dsi_diag, bool, 0644);
+MODULE_PARM_DESC(tb_dsi_diag, "TB710FU: print the periodic DSI heartbeat/controller diagnostics");
+
+static void tb710fu_ctrl_fixup(struct msm_dsi_host *msm_host)
+{
+	dsi_write(msm_host, REG_DSI_CTRL, 0x1f7);
+	dsi_write(msm_host, 0x03c, 0x06100009);
+	dsi_write(msm_host, REG_DSI_CMD_CFG1, 0x00013c2c);
+	dsi_write(msm_host, 0x080, 0x80000004);
+	dsi_write(msm_host, REG_DSI_HS_TIMER_CTRL, 0x0004ea60);
+	dsi_write(msm_host, REG_DSI_TIMEOUT_STATUS, 0x00000000);
+	dsi_write(msm_host, REG_DSI_CLKOUT_TIMING_CTRL, 0x00000000);
+	dsi_write(msm_host, 0x114, 0x00001c00);
+	dsi_write(msm_host, 0x1b4, 0x00110006);
+	dsi_write(msm_host, 0x1c8, 0x00000007);
+	dsi_write(msm_host, 0x32c, 0x33531000);
+	dsi_write(msm_host, 0x158, 0x00000000);
+}
+
+/*
+ * TB710FU: ABL brings the display up (the splash is visible until the kernel
+ * handover) and leaves the whole display subsystem powered across the boot -
+ * pd_ignore_unused / clk_ignore_unused keep the rails, GDSCs and gates on.
+ * Before our driver touches anything, snapshot the DSI controller + PLL + PHY
+ * and the DPU DSC blocks exactly as the bootloader left them.  That state is
+ * a known-good vendor configuration; the diff against ours is the answer we
+ * have been hunting for eight kernel versions.
+ */
+static void tb710fu_abl_reg_dump_tagged(const char *tag)
+{
+	static const struct { phys_addr_t base; unsigned int len; const char *name; } ranges[] = {
+		{ 0x0ae94000ULL, 0x2000, "dsi0-ctrl+pll+phy" },
+		{ 0x0ae96000ULL, 0x2000, "dsi1-ctrl+pll+phy" },
+	};
+	int i, off;
+
+	for (i = 0; i < ARRAY_SIZE(ranges); i++) {
+		void __iomem *b = ioremap(ranges[i].base, ranges[i].len);
+
+		pr_err("TBDUMP begin %s %s\n", tag, ranges[i].name);
+		if (!b) {
+			pr_err("TBDUMP %s: ioremap failed\n", ranges[i].name);
+			continue;
+		}
+		for (off = 0; off < ranges[i].len; off += 16) {
+			u32 w[4];
+			int j;
+
+			for (j = 0; j < 4; j++)
+				/* fault-tolerant read: holes or unpowered
+				 * islands inside a range must not abort */
+				copy_from_kernel_nofault(&w[j], b + off + 4 * j, 4);
+
+			if (w[0] | w[1] | w[2] | w[3])
+				pr_err("TBDUMP %s %s +%#05x %08x %08x %08x %08x\n",
+				       tag, ranges[i].name, off, w[0], w[1], w[2], w[3]);
+		}
+		iounmap(b);
+		pr_err("TBDUMP end %s %s\n", tag, ranges[i].name);
+	}
+	pr_err("TBDUMP done %s\n", tag);
+}
+
+static int __init tb710fu_abl_reg_dump(void)
+{
+	tb710fu_abl_reg_dump_tagged("ABL");
+	return 0;
+}
+early_initcall(tb710fu_abl_reg_dump);
+
+/*
+ * Runtime controller-only dump for the ABL-vs-ours diff.  The full range above
+ * also covers the PHY lane block (base + 0x1000 upward) and the PLL, and
+ * reading those while the PHY is live is what took the board down silently -
+ * the OURS dump at round 1 produced no log lines at all and the boot died
+ * before its first flash snapshot.  The DSI controller window (0x000..0x1ff) is
+ * the part the heartbeat already reads every 10s, so it is safe.
+ */
+static void tb710fu_ours_ctrl_dump(void)
+{
+	static const phys_addr_t bases[] = { 0x0ae94000ULL, 0x0ae96000ULL };
+	static const char *const names[] = { "dsi0-ctrl", "dsi1-ctrl" };
+	int i, off;
+
+	for (i = 0; i < ARRAY_SIZE(bases); i++) {
+		void __iomem *b = ioremap(bases[i], 0x200);
+
+		if (!b) {
+			pr_err("TBDUMP ours: ioremap failed for %s\n", names[i]);
+			continue;
+		}
+		for (off = 0; off < 0x200; off += 16) {
+			u32 w[4];
+			int j;
+
+			for (j = 0; j < 4; j++)
+				copy_from_kernel_nofault(&w[j], b + off + 4 * j, 4);
+			pr_err("TBDUMP OURSC %s +%#05x %08x %08x %08x %08x\n",
+			       names[i], off, w[0], w[1], w[2], w[3]);
+		}
+		iounmap(b);
+		pr_err("TBDUMP end OURSC %s\n", names[i]);
+	}
+	pr_err("TBDUMP done OURSC\n");
+}
