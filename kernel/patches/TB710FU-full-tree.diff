+/*
+ * TB710FU bring-up: draw boot progress as coloured blocks on the ABL
+ * splash framebuffer (0xD5100000, 3200x2000, stride 3200, 32bpp), which
+ * the display pipeline keeps scanning after handoff.  Phys->virt via the
+ * linear map; dcache_clean_poc makes the writes visible to the display.
+ *
+ *   red   = start_kernel entered       magenta = sched_init()
+ *   green = setup_arch() done          cyan    = rest_init()
+ *   blue  = parse_early_param()        white   = (unknown code)
+ *   yellow= trap_init()
+ */
+#define TB_FB_PHYS	0xD5100000UL
+#define TB_FB_STRIDE	3200
+
+void tb_mark(u64 base, u32 code);
+static void tb_strip_draw(u64 base, unsigned int n);
+
+void tb_mark(u64 base, u32 code)
+{
+	static int idx;
+	unsigned *fb = (unsigned *)base;
+	unsigned col, *row;
+	unsigned long start, end;
+	int i, j;
+
+	/* Use the base this call was given, never a cached one: the early rungs pass
+	 * the identity address (TTBR0 still holds the idmap) and the later ones pass
+	 * the linear mapping. Caching the first value sent every later rung to
+	 * 0xd5100000 + offset, which in the init thread - where TTBR0 no longer
+	 * carries the identity map - is a user address with no page tables behind
+	 * it, and took the init thread down with a translation fault. */
+	if (idx >= 48)
+		return;
+
+	switch (code) {
+	case 0x1001: col = 0xffff0000; break;	/* red    */
+	case 0x1002: col = 0xff00ff00; break;	/* green  */
+	case 0x1003: col = 0xff0000ff; break;	/* blue   */
+	case 0x1004: col = 0xffffff00; break;	/* yellow */
+	case 0x1005: col = 0xffff00ff; break;	/* magenta*/
+	case 0x1006: col = 0xff00ffff; break;	/* cyan   */
+	case 0x1010: col = 0xffff8000; break;	/* orange */
+	case 0x1011: col = 0xff808000; break;
+	case 0x1012: col = 0xff008080; break;
+	case 0x1013: col = 0xff800080; break;
+	case 0x1014: col = 0xff808080; break;
+	case 0x1015: col = 0xffe0e0e0; break;
+	case 0x1020: col = 0xffffc0c0; break;	/* past cpu_uninstall_idmap */
+	case 0x1021: col = 0xff804000; break;
+	case 0x1022: col = 0xff008000; break;
+	case 0x1023: col = 0xff000080; break;
+	case 0x1024: col = 0xff800000; break;
+	case 0x1025: col = 0xffc0ffc0; break;	/* paging_init entered */
+	case 0x1026: col = 0xff4040ff; break;	/* map_mem done */
+	case 0x1027: col = 0xffffc000; break;	/* create_idmap done */
+	case 0x1028: col = 0xffffffff; break;	/* paging_init done */
+	case 0x1030: col = 0xff208020; break;	/* kernel_init entered */
+	case 0x1031: col = 0xff7f7fff; break;	/* do_initcalls done */
+	case 0x1032: col = 0xffff7f7f; break;	/* about to exec init */
+	case 0x1033: col = 0xff7f3f00; break;	/* panic() */
+	case 0x1040: col = 0xff808080; break;	/* initcall level 0 */
+	case 0x1041: col = 0xffc0c0c0; break;
+	case 0x1042: col = 0xffe0e0e0; break;
+	case 0x1043: col = 0xff8080ff; break;
+	case 0x1044: col = 0xff80ff80; break;
+	case 0x1045: col = 0xffff8080; break;
+	case 0x1046: col = 0xffffff80; break;
+	case 0x1047: col = 0xffff80ff; break;	/* initcall level 7 */
+	case 0x1048: col = 0xff00ff00; break;	/* simplefb_probe entered */
+	case 0x1049: col = 0xff0000ff; break;	/* register_framebuffer returned */
+	default:     col = 0xffffffff; break;	/* white  */
+	}
+
+	/* Eight to a row now that there are nineteen rungs. */
+	row = fb + (100 + 200 * (idx / 8)) * TB_FB_STRIDE + 100 + 180 * (idx % 8);
+	start = (unsigned long)row;
+	for (i = 0; i < 160; i++) {
+		unsigned *line = row + (unsigned long)i * TB_FB_STRIDE;
+
+		for (j = 0; j < 160; j++)
+			line[j] = col;
+	}
+	end = (unsigned long)(row + 160L * TB_FB_STRIDE);
+	dcache_clean_poc(start, end);
+	idx++;
+	tb_strip_draw(base, idx);
+}
