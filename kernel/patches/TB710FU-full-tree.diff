+/* First thing of the boot, before the console replays anything: keep what the
+ * previous boot left and mark the seam, so the band can find its tail. */
+static void __init tb_bb_boot_marker(void)
+{
+	int k;
+
+	for (k = 0; k < TB_BB_SLOTS; k++) {
+		struct tb_bb *bb = (struct tb_bb *)__va(tb_bb_pa[k]);
+
+		tb_bb_ok[k] = bb->magic == TB_BB_MAGIC &&
+			      bb->size == TB_BB_SIZE - sizeof(*bb);
+		if (!tb_bb_ok[k]) {
+			bb->magic = TB_BB_MAGIC;
+			bb->size = TB_BB_SIZE - sizeof(*bb);
+			bb->head = 0;
+			bb->boots = 0;
+		}
+		tb_bb_seam[k] = bb->head;
+		tb_bb_was_head[k] = bb->head;
+		bb->boots++;
+		tb_bb_was_boots[k] = bb->boots;
+		dcache_clean_poc((unsigned long)bb, (unsigned long)(bb + 1));
+	}
+
+	tb_bb_put("\n===== BOOT =====\n", 18);
+}
+
+/* The band's first row is drawn even when there is no previous text: that is
+ * what separates "the band does not draw" from "the ring is empty". */
+static void __init tb_bb_band_header(void)
+{
+	char buf[TB_CON_COLS + 1];
+	unsigned int i;
+	int n;
+
+	n = snprintf(buf, sizeof(buf), "BB A:%s h=%u b=%u   B:%s h=%u b=%u",
+		     tb_bb_ok[0] ? "PREV" : "fresh", tb_bb_was_head[0], tb_bb_was_boots[0],
+		     tb_bb_ok[1] ? "PREV" : "fresh", tb_bb_was_head[1], tb_bb_was_boots[1]);
+
+	for (i = 0; i < TB_CON_COLS; i++)
+		tb_bb_band[i] = (n > 0 && i < (unsigned int)n) ? buf[i] : ' ';
+}
+
+/* Copy the last few non-empty lines of the previous boot into the band, one row
+ * below the header. */
+static void __init tb_bb_load_prev(void)
+{
+	int pick = tb_bb_ok[0] ? 0 : (tb_bb_ok[1] ? 1 : -1);
+	const int rows = TB_CON_BAND_ROWS - 1;
+	struct tb_bb *bb;
+	u32 cap = TB_BB_SIZE - sizeof(struct tb_bb);
+	char ordered[(TB_CON_BAND_ROWS - 1) * TB_CON_COLS];
+	unsigned int i, n;
+	u32 start;
+	int line = 0, col = 0, r, c, first;
+
+	for (i = 0; i < sizeof(tb_bb_band); i++)
+		tb_bb_band[i] = ' ';
+
+	tb_bb_band_header();
+	if (pick < 0)
+		return;
+
+	bb = (struct tb_bb *)__va(tb_bb_pa[pick]);
+
+	start = tb_bb_seam[pick] > TB_BB_SHOW ? tb_bb_seam[pick] - TB_BB_SHOW : 0;
+	for (i = start; i <= tb_bb_seam[pick]; i++) {
+		char ch = i < tb_bb_seam[pick] ? bb->data[i % cap] : '\n';
+
+		if (ch == '\n') {
+			if (col)
+				line++;
+			col = 0;
+			continue;
+		}
+		if (ch < 32 || ch > 126)
+			ch = ' ';
+		if (col < TB_CON_COLS && line < rows)
+			ordered[(line % rows) * TB_CON_COLS + col] = ch;
+		col++;
+	}
+
+	/* Rows came out rotated (line k landed in slot k % rows); put them in order
+	 * and place them one row below the header. */
+	first = line > rows ? line - rows : 0;
+	for (r = 0; r < rows; r++) {
+		int src = (first + r) % rows;
+
+		for (c = 0; c < TB_CON_COLS; c++)
+			tb_bb_band[(r + 1) * TB_CON_COLS + c] = (first + r) < line ?
+				ordered[src * TB_CON_COLS + c] : ' ';
+	}
+}
