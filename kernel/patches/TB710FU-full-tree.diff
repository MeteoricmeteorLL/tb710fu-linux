+	dt_start = ktime_get_ns();
+	now = dt_start;
+	if (tb710fu_poll_last_ns) {
+		gap_ms = div_u64(now - tb710fu_poll_last_ns, 1000000);
+		if (gap_ms > tb710fu_poll_max_gap_ms)
+			tb710fu_poll_max_gap_ms = gap_ms;
+		if (gap_ms > 100)
+			tb710fu_poll_slow++;
+	}
+	tb710fu_poll_last_ns = now;
+
