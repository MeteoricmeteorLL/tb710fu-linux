+/*
+ * acm45: TB710FU 的 WCN7850 端点 MSI 一次都不会送到主机, 于是 CE(拷贝引擎)环
+ * 没有任何中断去服务 —— HTC/WMI 的命令响应永远收不到(实测 `Service connect
+ * timeout` / 后续 WMI 全超时)。这里在"等待线程内部"轮询 CE 环(与
+ * ath12k_htc_wait_target() 的兜底写法同构), 不用独立线程, 避免抢跑/所有权问题。
+ */
+/* acm47: 轮询可能同时来自"等待线程"(acm45/46) 与"周期 work"(acm47),
+ * 并发处理同一个 CE completion 会重复完成/踩坏链表, 这里串行化。
+ * 两个调用者都在进程上下文, 用 mutex 安全。
+ */
+static DEFINE_MUTEX(ath12k_tb710fu_ce_lock);
+
+void ath12k_htc_poll_ce_all(struct ath12k_base *ab)
+{
+	int i;
+
+	mutex_lock(&ath12k_tb710fu_ce_lock);
+	for (i = 0; i < ab->hw_params->ce_count; i++)
+		ath12k_ce_per_engine_service(ab, i);
+	mutex_unlock(&ath12k_tb710fu_ce_lock);
+}
+EXPORT_SYMBOL(ath12k_htc_poll_ce_all);
+
+int ath12k_htc_poll_wait_completion(struct ath12k_base *ab,
+				    struct completion *done,
+				    unsigned long timeout)
+{
+	unsigned long deadline = jiffies + timeout;
+
+	do {
+		if (wait_for_completion_timeout(done, msecs_to_jiffies(5)))
+			return 1;
+
+		ath12k_htc_poll_ce_all(ab);
+	} while (time_before(jiffies, deadline));
+
+	return 0;
+}
+EXPORT_SYMBOL(ath12k_htc_poll_wait_completion);
