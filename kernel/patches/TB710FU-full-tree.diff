+static void ath12k_tb710fu_ce_poll_work(struct work_struct *work)
+{
+	struct ath12k_base *ab = container_of(work, struct ath12k_base,
+					      tb710fu_ce_poll_work.work);
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
+	unsigned long long now, dt_start;
+	unsigned int gap_ms = 0;
+	unsigned int dt_ms;
+	unsigned int budget;
+	int i;
