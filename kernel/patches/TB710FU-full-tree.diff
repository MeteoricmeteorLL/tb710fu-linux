+/*
+ * acm37: MSI 旁路 —— 用内核线程轮询 event ring, 代替设备->主机 MSI。
+ * 调用的就是硬中断处理程序本体, 完全等价于"收到一次 MSI"。
+ */
+static struct task_struct *acm37_poll_task;
+
+static int acm37_poll_thread(void *data)
+{
+	struct mhi_controller *mhi_cntrl = data;
+	struct mhi_event *ev;
+	unsigned long n = 0;
+	int i;
+
+	while (!kthread_should_stop()) {
+		/* acm38: 错误态也继续跑(原本一见 ERROR 就退, 后面的
+		 * RDDM/恢复事件就没人送了), 只在真正 DISABLE 时退出。 */
+		if (mhi_cntrl->pm_state == MHI_PM_DISABLE)
+			break;
+		if (!mhi_cntrl->mhi_ctxt)
+			break;
+
+		ev = mhi_cntrl->mhi_event;
+		for (i = 0; i < mhi_cntrl->total_ev_rings; i++, ev++)
+			mhi_irq_handler(0, ev);
+
+		/* acm39: 控制器级状态机(SYS_ERR/RDDM 检测)也要喂 */
+		mhi_intvec_threaded_handler(0, mhi_cntrl);
+
+		if ((n % 300) == 0)
+			dev_info(&mhi_cntrl->mhi_dev->dev,
+				 "acm37: poll n=%lu pm=%s ee=%s dev_state=%d m0=%u\n",
+				 n, to_mhi_pm_state_str(mhi_cntrl->pm_state),
+				 TO_MHI_EXEC_STR(mhi_cntrl->ee),
+				 mhi_cntrl->dev_state, mhi_cntrl->M0);
+		n++;
+		msleep(100);
+	}
+
+	dev_info(&mhi_cntrl->mhi_dev->dev, "acm37: poll thread exit n=%lu\n", n);
+	acm37_poll_task = NULL;
+	return 0;
+}
+
