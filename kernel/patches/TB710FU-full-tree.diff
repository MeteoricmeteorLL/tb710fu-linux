+static int audioreach_tdm_sink_set_media_format(struct q6apm_graph *graph,
+						const struct audioreach_module *module,
+						const struct audioreach_module_config *cfg)
+{
+	if (tb_tdmmode == 4) {
+		struct param_id_audio_if_intf_cfg *ic;
+		struct apm_module_param_data *pd;
+		/* TB710FU: the tplg carries the vendor's 4-slot mask; the DAI
+		 * path can end up with a stale value, so prefer the tplg. */
+		u32 slot_mask = module->slot_mask ? module->slot_mask : cfg->slot_mask;
+		u16 nslots = cfg->nslots_per_frame ?
+			     (u16)cfg->nslots_per_frame : module->nslots_per_frame;
+		u16 swidth = cfg->slot_width ? (u16)cfg->slot_width : module->slot_width;
+		int size = ALIGN(APM_MODULE_PARAM_DATA_SIZE + sizeof(*ic), 8);
+		struct gpr_pkt *pkt __free(kfree);
+		void *p;
+		int rc;
+
+		tb_tdm_send_param(graph, module, cfg, 2);
+		tb_tdm_send_param(graph, module, cfg, 4);
+
+		pkt = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+		if (IS_ERR(pkt))
+			return PTR_ERR(pkt);
+
+		p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+		pd = p;
+		pd->module_instance_id = module->instance_id;
+		pd->error_code = 0;
+		pd->param_id = 0x0800113c;
+		pd->param_size = sizeof(*ic);
+		ic = p + APM_MODULE_PARAM_DATA_SIZE;
+		memset(ic, 0, sizeof(*ic));
+		ic->qaif_type = module->qaif_type;
+		ic->intf_idx = (u16)module->hw_interface_idx;
+		ic->intf_mode = module->intf_mode;
+		ic->ctrl_data_out_enable = module->ctrl_data_out_enable;
+		ic->active_slot_mask = slot_mask;
+		ic->nslots_per_frame = nslots;
+		ic->slot_width = swidth;
+		ic->active_lane_mask = module->active_lane_mask;
+		ic->frame_sync_rate = module->frame_sync_rate;
+		ic->frame_sync_src = module->sync_src;
+		ic->frame_sync_mode = module->sync_mode;
+		ic->invert_frame_sync_pulse = module->ctrl_invert_sync_pulse;
+		ic->frame_sync_data_delay = module->ctrl_sync_data_delay;
+		ic->bit_clk_type = module->bit_clk_type;
+		if ((cfg->fmt & SND_SOC_DAIFMT_INV_MASK) == SND_SOC_DAIFMT_IB_NF ||
+		    (cfg->fmt & SND_SOC_DAIFMT_INV_MASK) == SND_SOC_DAIFMT_IB_IF)
+			ic->inv_int_bit_clk = 1;
+		if ((cfg->fmt & SND_SOC_DAIFMT_INV_MASK) == SND_SOC_DAIFMT_NB_IF ||
+		    (cfg->fmt & SND_SOC_DAIFMT_INV_MASK) == SND_SOC_DAIFMT_IB_IF)
+			ic->invert_frame_sync_pulse = 1;
+
+		rc = q6apm_send_cmd_sync(graph->apm, pkt, 0);
+		dev_info(graph->dev, "TB TDM mode4 rc=%d payload(mask=0x%x ns=%d w=%d mode=%d sync=%d src=%d inv=%d dly=%d)\n",
+			 rc, ic->active_slot_mask, ic->nslots_per_frame, ic->slot_width,
+			 ic->intf_mode, ic->frame_sync_mode, ic->frame_sync_src,
+			 ic->inv_int_bit_clk, ic->frame_sync_data_delay);
+		dev_info(graph->dev, "TB TDM mode4 srcs(cfg mask=0x%x ns=%d w=%d fmt=0x%x | tplg mask=0x%x ns=%d w=%d idx=%d mode=%d sync=%d src=%d inv=%d dly=%d dfmt=%d)\n",
+			 cfg->slot_mask, cfg->nslots_per_frame, cfg->slot_width, cfg->fmt,
+			 module->slot_mask, module->nslots_per_frame, module->slot_width,
+			 module->hw_interface_idx, module->intf_mode, module->sync_mode,
+			 module->sync_src, module->ctrl_invert_sync_pulse,
+			 module->ctrl_sync_data_delay, module->data_format);
+		return 0;
+	}
+
+	if (tb_tdmmode == 5) {
+		struct apm_module_hw_ep_power_mode_cfg *pm;
+		struct apm_module_frame_size_factor_cfg *fsc;
+		struct param_id_audio_if_intf_cfg *ic;
+		struct apm_module_hw_ep_mf_cfg *mf;
+		struct apm_module_param_data *pd;
+		u32 slot_mask = module->slot_mask ? module->slot_mask : cfg->slot_mask;
+		u16 nslots = module->nslots_per_frame ?
+			     (u16)module->nslots_per_frame : cfg->nslots_per_frame;
+		u16 swidth = module->slot_width ? (u16)module->slot_width : cfg->slot_width;
+		int isz = ALIGN(APM_MODULE_PARAM_DATA_SIZE + sizeof(*ic), 8);
+		int msz = APM_HW_EP_CFG_PSIZE;
+		int fsz = APM_FS_CFG_PSIZE;
+		int psz = APM_HW_EP_PMODE_CFG_PSIZE;
+		int size = isz + msz + fsz + psz;
+		struct gpr_pkt *pkt __free(kfree);
+		void *p;
+		int rc;
+
+		pkt = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+		if (IS_ERR(pkt))
+			return PTR_ERR(pkt);
+
+		p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+
+		pd = p;
+		pd->module_instance_id = module->instance_id;
+		pd->error_code = 0;
+		pd->param_id = 0x0800113c;
+		pd->param_size = sizeof(*ic);
+		ic = p + APM_MODULE_PARAM_DATA_SIZE;
+		memset(ic, 0, sizeof(*ic));
+		ic->qaif_type = module->qaif_type;
+		ic->intf_idx = (u16)module->hw_interface_idx;
+		ic->intf_mode = module->intf_mode;
+		ic->ctrl_data_out_enable = module->ctrl_data_out_enable;
+		ic->active_slot_mask = slot_mask;
+		ic->nslots_per_frame = nslots;
+		ic->slot_width = swidth;
+		ic->active_lane_mask = module->active_lane_mask;
+		ic->frame_sync_rate = module->frame_sync_rate;
+		ic->frame_sync_src = module->sync_src;
+		ic->frame_sync_mode = module->sync_mode;
+		ic->invert_frame_sync_pulse = module->ctrl_invert_sync_pulse;
+		ic->frame_sync_data_delay = module->ctrl_sync_data_delay;
+		ic->bit_clk_type = module->bit_clk_type;
+		if ((cfg->fmt & SND_SOC_DAIFMT_INV_MASK) == SND_SOC_DAIFMT_IB_NF ||
+		    (cfg->fmt & SND_SOC_DAIFMT_INV_MASK) == SND_SOC_DAIFMT_IB_IF)
+			ic->inv_int_bit_clk = 1;
+		p += isz;
+
+		mf = p;
+		pd = &mf->param_data;
+		pd->module_instance_id = module->instance_id;
+		pd->error_code = 0;
+		pd->param_id = PARAM_ID_HW_EP_MF_CFG;
+		pd->param_size = msz - APM_MODULE_PARAM_DATA_SIZE;
+		mf->mf.sample_rate = cfg->sample_rate;
+		mf->mf.bit_width = cfg->bit_width;
+		mf->mf.num_channels = cfg->num_channels;
+		mf->mf.data_format = module->data_format;
+		p += msz;
+
+		fsc = p;
+		pd = &fsc->param_data;
+		pd->module_instance_id = module->instance_id;
+		pd->error_code = 0;
+		pd->param_id = PARAM_ID_HW_EP_FRAME_SIZE_FACTOR;
+		pd->param_size = fsz - APM_MODULE_PARAM_DATA_SIZE;
+		fsc->frame_size_factor = 1;
+		p += fsz;
+
+		pm = p;
+		pd = &pm->param_data;
+		pd->module_instance_id = module->instance_id;
+		pd->error_code = 0;
+		pd->param_id = PARAM_ID_HW_EP_POWER_MODE_CFG;
+		pd->param_size = psz - APM_MODULE_PARAM_DATA_SIZE;
+		pm->power_mode.power_mode = 0;
+		p += psz;
+
+		rc = q6apm_send_cmd_sync(graph->apm, pkt, 0);
+		return 0;
+	}
+
+	if (tb_scan_lo >= 0 && tb_scan_lo <= tb_scan_hi) {
+		int id, rc;
+
+		for (id = tb_scan_lo; id <= tb_scan_hi; id++) {
+			rc = tb_tdm_raw_param(graph, module, id, tb_scan_size);
+			if (!rc)
+				dev_info(graph->dev, "TBSCAN HIT id=0x%08x size=%d\n",
+					 id, tb_scan_size);
+		}
+		dev_info(graph->dev, "TBSCAN done %x..%x size=%d\n",
+			 tb_scan_lo, tb_scan_hi, tb_scan_size);
+		return 0;
+	}
+
+	if (tb_probe_id >= 0) {
+		int rc;
+
+		tb_tdm_send_param(graph, module, cfg, 2);
+		tb_tdm_send_param(graph, module, cfg, 4);
+		tb_tdm_raw_param(graph, module, 0x08001176, 4);
+		rc = tb_tdm_raw_param(graph, module, tb_probe_id, tb_probe_size);
+
+		dev_info(graph->dev, "TBPROBE id=0x%08x size=%d rc=%d\n",
+			 tb_probe_id, tb_probe_size, rc);
+		return 0;
+	}
+
+	if (tb_tdmbits < 0) {
+		if (tb_tdmmode == 1)
+			return audioreach_audio_if_set_media_format(graph, module, cfg);
+		if (tb_tdmmode == 2)
+			return audioreach_i2s_set_media_format(graph, module, cfg);
+		if (tb_tdmmode == 3)
+			return audioreach_codec_dma_set_media_format(graph, module, cfg);
+		return 0;
+	}
+
+	/* probe mode: one SET_CFG per parameter, keep going on errors */
+	if (tb_tdmbits & 1)
+		tb_tdm_send_param(graph, module, cfg, 1);
+	if (tb_tdmbits & 2)
+		tb_tdm_send_param(graph, module, cfg, 2);
+	if (tb_tdmbits & 4)
+		tb_tdm_send_param(graph, module, cfg, 4);
+	if (tb_tdmbits & 8)
+		tb_tdm_send_param(graph, module, cfg, 8);
+	if (tb_tdmbits & 16)
+		tb_tdm_send_param(graph, module, cfg, 16);
+
+	return 0;
+}
