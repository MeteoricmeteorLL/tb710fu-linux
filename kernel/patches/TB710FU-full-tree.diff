+/*
+ * TB710FU: the vendor byte stream sends 0xC0/0x98 as DCS long writes (0x39)
+ * even though each carries a single parameter; mipi_dsi_dcs_write_buffer()
+ * would downgrade that to a short write (0x15).  Replay the vendor framing.
+ */
+static void tb710fu_vendor_long_write(struct panel_info *pinfo,
+				      const u8 *buf, size_t len)
+{
+	struct mipi_dsi_msg msg = {
+		.type = MIPI_DSI_DCS_LONG_WRITE,
+		.tx_buf = buf,
+		.tx_len = len,
+	};
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		ssize_t ret;
+
+		if (!pinfo->dsi[i])
+			continue;
+		msg.channel = pinfo->dsi[i]->channel;
+		ret = pinfo->dsi[i]->host->ops->transfer(pinfo->dsi[i]->host, &msg);
+		if (ret < 0)
+			pr_err("TBPANEL vendor long write %#x dsi%d failed: %zd\n",
+			       buf[0], i, ret);
+	}
+}
