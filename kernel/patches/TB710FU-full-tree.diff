+/* ---------------------------------------------------------------------------
+ * TB710FU: a reboot backstop, armed by /chosen/tb,autoreboot-seconds.
+ *
+ * The initramfs has a path for "reached user space but no USB channel"; this
+ * covers the case where user space is never reached at all - an initcall
+ * spinning, a panic looping without a reset - which otherwise leaves the board
+ * sitting there until someone power cycles it by hand.  With the timer armed the
+ * board comes back on its own, ABL's retry counter runs down, and the device
+ * lands in fastboot unattended.
+ *
+ * An early initcall, so it is armed before do_initcalls() runs; the timer
+ * subsystem and jiffies are up by then, and tick_init() has already warned if
+ * interrupts are still masked.
+ */
+static unsigned int tb_autoreboot_secs;
+static struct timer_list tb_autoreboot_timer;
