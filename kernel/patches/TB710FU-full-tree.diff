+			    tb710fu_poll_ticks, tb710fu_poll_rx,
+			    tb710fu_poll_max_gap_ms, tb710fu_poll_slow,
+			    tb710fu_poll_ms, budget);
+		tb710fu_poll_max_gap_ms = 0;
+		tb710fu_poll_slow = 0;
+	}
+
+	/* acm49: 本轮耗时，超过 50ms 就记一笔（日志里能看到是轮询自己卡住了） */
