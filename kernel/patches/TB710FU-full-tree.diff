+/* ---------------------------------------------------------------------------
+ * TB710FU: keep the display's memory path voted.
+ *
+ * The panel dies at the end of boot while the RSC is enabled and survives while
+ * it is not, and the interconnect framework ties the two together: the NoC
+ * providers only probe once their clocks and the RPMh BCM voter are up (the
+ * RSC), and once the last of them has probed, icc_sync_state() zeroes every
+ * node's boot-time request and re-applies the aggregate.  With mdss disabled
+ * nothing holds a vote for the display's path, so that aggregate falls to zero,
+ * the NoC stops reserving the bandwidth the DPU's scanout keeps consuming, and
+ * the panel loses its stream - white then black, right as the probe sequence
+ * finishes.
+ *
+ * So be a consumer: the device tree node "tb,icc-keepalive" describes the
+ * display path, the framework resolves it and defers this probe until the
+ * providers are up, and we then hold the bandwidth forever.  That is what the
+ * DRM/DSI stack will do properly once it exists.  Voting late is fine:
+ * icc_set_bw() re-aggregates and re-programs the nodes, undoing the zeroing
+ * that icc_sync_state() already did.
+ */
+static int tb_icc_keepalive_held;	/* paths actually held */
+#define TB_ICC_KEEPALIVE_KBPS	2000000U	/* 3200x2000x4 at 60 Hz is ~1.5 GB/s */
+
+static int tb_icc_keepalive_probe(struct platform_device *pdev)
+{
+	struct icc_path *path;
+
+	path = devm_of_icc_get(&pdev->dev, "mdp0-mem");
+	if (IS_ERR(path))
+		return dev_err_probe(&pdev->dev, PTR_ERR(path),
+				     "display path not available yet\n");
+
+	if (icc_set_bw(path, TB_ICC_KEEPALIVE_KBPS, TB_ICC_KEEPALIVE_KBPS))
+		return -EIO;
+
+	dev_info(&pdev->dev, "holding %u KB/s on the display's memory path\n",
+		 TB_ICC_KEEPALIVE_KBPS);
+	tb_icc_keepalive_held++;
+
+	return 0;
+}
