+static int __init tb_autoreboot_arm(void)
+{
+	if (!of_chosen ||
+	    of_property_read_u32(of_chosen, "tb,autoreboot-seconds",
+				 &tb_autoreboot_secs) || !tb_autoreboot_secs)
+		return 0;
+
+	timer_setup(&tb_autoreboot_timer, tb_autoreboot_fn, 0);
+	mod_timer(&tb_autoreboot_timer,
+		  jiffies + (unsigned long)tb_autoreboot_secs * HZ);
+	pr_info("TB AUTO-REBOOT armed for %u s\n", tb_autoreboot_secs);
+
+	return 0;
